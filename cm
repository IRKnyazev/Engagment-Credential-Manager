def add_secret_flags(p):
    g = p.add_argument_group("secret (choose one)")
    g.add_argument("--pass", dest="password", help="plaintext password")
    g.add_argument("--nt", help="NTLM hash")
    g.add_argument("--hash", help="TYPE:VALUE, e.g. kerberos_tgs:'$krb5tgs$...'")
    g.add_argument("--key", help="path to an SSH private key file")
    g.add_argument("--pfx", help="path to a certificate/PFX file")
    g.add_argument("--ticket", help="path to a Kerberos ticket (.ccache/.kirbi)")
    g.add_argument("--expires", help="ticket expiry (free text), e.g. '2026-10-08 18:00'")
    g.add_argument("--label", help="label for a 'hash:other:' or custom secret")


def add_identity_flags(p):
    p.add_argument("--realm", help="override realm: domain:FQDN | host:NAME | service:HOST:PORT")
    p.add_argument("--null", action="store_true", help="the empty-string principal (SMB null session)")


def add_target_flags(p):
    p.add_argument("--at", help="target HOST or HOST:PORT")
    p.add_argument("--proto", help="protocol (smb, ssh, winrm, http, mysql, mssql, ...)")
    p.add_argument("--priv", help="privilege (host: user/local_admin/domain_admin/root; service: free text)")
    p.add_argument("--scope", choices=SCOPES, help="force host or service scope")


def build_parser():
    p = argparse.ArgumentParser(
        prog="cm", description="credential manager for pentest/CTF engagements",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="examples:\n"
               "  cm init corp.db\n"
               "  cm cred 'CORP\\jsmith' --nt 00112233... --src responder-mitm@10.0.0.50\n"
               "  cm works 'CORP\\jsmith' --at HOST1,HOST2 --proto smb --priv user\n"
               "  cm cracked --from hashcat.potfile\n"
               "  cm export pairs --type ntlm > userhash.txt\n")
    p.add_argument("--db", help="engagement database (env CM_DB, default ./engagement.db)")
    p.add_argument("-q", "--quiet", action="store_true", help="suppress the teaching echo lines")
    p.add_argument("--version", action="version", version="cm " + VERSION)
    sub = p.add_subparsers(dest="cmd", required=True)

    # init
    sp = sub.add_parser("init", help="create / ensure an engagement db")
    sp.add_argument("path", nargs="?", help="db path (overrides --db / default)")
    sp.set_defaults(func=cmd_init)

    # cred (macro)
    sp = sub.add_parser("cred", help="record a credential (upserts identity+secret+link, optional target)")
    sp.add_argument("identity", nargs="?", help="DOMAIN\\user | user@host | user@host:port")
    add_identity_flags(sp)
    add_secret_flags(sp)
    add_target_flags(sp)
    sp.add_argument("--status", choices=STATUSES, help="access status (default untested when --at given)")
    sp.add_argument("--origin", choices=ORIGINS, help="credential origin (default discovered)")
    sp.add_argument("--src", help="provenance note, e.g. 'web.config on HOST5'")
    sp.add_argument("--desc", help="identity description")
    sp.add_argument("--uid", type=int, help="linux uid")
    sp.add_argument("--shell", help="linux shell")
    sp.set_defaults(func=cmd_cred)

    # works / fail (macro)
    for name, fn, helptext in (("works", cmd_works, "confirm a working login (status=valid)"),
                               ("fail", cmd_fail, "record a failed login (status=invalid)")):
        sp = sub.add_parser(name, help=helptext)
        sp.add_argument("identity", nargs="?")
        add_identity_flags(sp)
        add_secret_flags(sp)
        sp.add_argument("--secret", help="existing secret ref (#id, type:value, or value prefix)")
        add_target_flags(sp)
        sp.add_argument("--src", help="provenance note")
        sp.set_defaults(func=fn)

    # reset (macro)
    sp = sub.add_parser("reset", help="tester-changed password: supersede old + add introduced")
    sp.add_argument("identity", nargs="?")
    add_identity_flags(sp)
    add_secret_flags(sp)
    sp.add_argument("--src", help="provenance note")
    sp.set_defaults(func=cmd_reset)

    # supersede (atomic)
    sp = sub.add_parser("supersede", help="mark an identity's secret stale")
    sp.add_argument("identity", nargs="?")
    add_identity_flags(sp)
    sp.add_argument("--secret", help="which secret (ref); inferred if the identity has one live")
    sp.set_defaults(func=cmd_supersede)

    # cracked (macro)
    sp = sub.add_parser("cracked", help="record that a hash was cracked to a plaintext")
    sp.add_argument("ref", nargs="?", help="hash ref (#id, type:value, or value prefix)")
    sp.add_argument("--pass", "--plaintext", dest="plaintext", help="the cracked plaintext")
    sp.add_argument("--from", dest="from_file", help="hashcat potfile / 'hash:plain' file")
    sp.add_argument("--stdin", action="store_true", help="read 'hash:plain' lines from stdin")
    sp.set_defaults(func=cmd_cracked)

    # unlock (atomic-ish)
    sp = sub.add_parser("unlock", help="link a passphrase to a key/pfx (unlocks)")
    sp.add_argument("--key", help="ssh key secret ref")
    sp.add_argument("--pfx", help="pfx secret ref")
    sp.add_argument("--secret", help="protected secret ref")
    sp.add_argument("--passphrase", help="the passphrase plaintext")
    sp.add_argument("--with", dest="with_secret", help="use an existing plaintext secret ref")
    sp.set_defaults(func=cmd_unlock)

    # add (atomic group)
    sp = sub.add_parser("add", help="atomic adders")
    asub = sp.add_subparsers(dest="addkind", required=True)
    a = asub.add_parser("host"); a.add_argument("name"); a.add_argument("--os")
    a.set_defaults(func=cmd_add_host)
    a = asub.add_parser("domain"); a.add_argument("fqdn"); a.set_defaults(func=cmd_add_domain)
    a = asub.add_parser("service"); a.add_argument("--host", required=True)
    a.add_argument("--port", type=int, required=True); a.add_argument("--name", default="")
    a.set_defaults(func=cmd_add_service)
    a = asub.add_parser("user"); a.add_argument("identity", nargs="?")
    add_identity_flags(a); a.add_argument("--desc"); a.add_argument("--uid", type=int)
    a.add_argument("--shell"); a.set_defaults(func=cmd_add_user)
    a = asub.add_parser("secret"); add_secret_flags(a); a.add_argument("--src")
    a.set_defaults(func=cmd_add_secret)

    # link (atomic)
    sp = sub.add_parser("link", help="link a secret to an identity")
    sp.add_argument("identity", nargs="?")
    add_identity_flags(sp)
    sp.add_argument("--secret", required=True)
    sp.add_argument("--origin", choices=ORIGINS)
    sp.set_defaults(func=cmd_link)

    # access (atomic)
    sp = sub.add_parser("access", help="record an access row directly")
    sp.add_argument("identity", nargs="?")
    add_identity_flags(sp)
    add_secret_flags(sp)
    sp.add_argument("--secret")
    add_target_flags(sp)
    sp.add_argument("--status", choices=STATUSES)
    sp.set_defaults(func=cmd_access)

    # observe (atomic)
    sp = sub.add_parser("observe", help="add a provenance observation")
    sp.add_argument("--user", help="identity token")
    sp.add_argument("--null", action="store_true")
    sp.add_argument("--realm")
    sp.add_argument("--secret", help="secret ref")
    sp.add_argument("--method", default="", help="how/where found")
    sp.add_argument("--host", help="host where found")
    sp.set_defaults(func=cmd_observe)

    # import
    sp = sub.add_parser("import", help="bulk import from tool output")
    isub = sp.add_subparsers(dest="impkind", required=True)
    i = isub.add_parser("passwd"); i.add_argument("--host", required=True); i.add_argument("file")
    i.set_defaults(func=cmd_import_passwd)
    i = isub.add_parser("shadow"); i.add_argument("--host", required=True); i.add_argument("file")
    i.set_defaults(func=cmd_import_shadow)
    i = isub.add_parser("ldapdomaindump"); i.add_argument("--domain", required=True); i.add_argument("file")
    i.set_defaults(func=cmd_import_ldap)
    i = isub.add_parser("secretsdump"); i.add_argument("--domain"); i.add_argument("--host")
    i.add_argument("file"); i.set_defaults(func=cmd_import_secretsdump)
    i = isub.add_parser("nxc"); i.add_argument("file"); i.set_defaults(func=cmd_import_nxc)

    # queries
    sp = sub.add_parser("users", help="list identities")
    sp.add_argument("--domain"); sp.add_argument("--host"); sp.add_argument("--realm", choices=REALM_TYPES)
    sp.set_defaults(func=cmd_users)

    sp = sub.add_parser("hashes", help="list stored hashes (optionally --type)")
    sp.add_argument("--type")
    sp.set_defaults(func=cmd_hashes)

    sp = sub.add_parser("todo-crack", help="crackable hashes not yet cracked and still live")
    sp.set_defaults(func=cmd_todo_crack)

    sp = sub.add_parser("where", help="where a cred works / who works on a host / all accesses")
    sp.add_argument("--user"); sp.add_argument("--null", action="store_true"); sp.add_argument("--realm")
    sp.add_argument("--host")
    sp.add_argument("--valid", action="store_true", help="with no --user/--host: only valid accesses")
    sp.set_defaults(func=cmd_where)

    sp = sub.add_parser("show", help="show a user or secret in detail")
    sp.add_argument("kind", choices=["user", "secret"])
    sp.add_argument("name")
    add_identity_flags(sp)
    sp.set_defaults(func=cmd_show)

    sp = sub.add_parser("stats", help="engagement summary counts")
    sp.set_defaults(func=cmd_stats)

    # export
    sp = sub.add_parser("export", help="emit users/passwords/pairs/hashes/key for other tools")
    sp.add_argument("what", choices=["users", "passwords", "pairs", "hashes", "key"])
    sp.add_argument("ref", nargs="?", help="secret ref (for `export key`)")
    sp.add_argument("--type", help="secret type (for pairs/hashes)")
    sp.add_argument("--domain"); sp.add_argument("--host")
    sp.add_argument("--introduced", action="store_true", help="only tester-introduced creds (pairs)")
    sp.add_argument("--all", action="store_true", help="include superseded links (pairs)")
    sp.set_defaults(func=cmd_export)

    return p


def resolve_db_path(args):
    if getattr(args, "cmd", None) == "init" and getattr(args, "path", None):
        return args.path
    if args.db:
        return args.db
    env = os.environ.get("CM_DB")
    if env:
        return env
    return "engagement.db"


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    parser = build_parser()
    args = parser.parse_args(argv)
    color = C(_use_color())
    db_path = resolve_db_path(args)
    store = Store(db_path, color, echo=not args.quiet)
    try:
        args.func(store, args)
    except CmError as e:
        print(color.red("error: ") + str(e), file=sys.stderr)
        return 1
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        return 0
    except KeyboardInterrupt:
        return 130
    except (sqlite3.Error, OSError, ValueError, OverflowError, UnicodeError) as e:
        # last-resort: a field tool should never spit a raw traceback. Turn any
        # stray library error into a clean message (set CM_DEBUG=1 to re-raise).
        if os.environ.get("CM_DEBUG"):
            raise
        print(color.red("error: ") + "%s: %s" % (type(e).__name__, e), file=sys.stderr)
        return 1
    finally:
        try:
            store.conn.close()
        except Exception:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
