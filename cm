def _read_lines(path):
    try:
        with open(path, "r", errors="replace") as fh:
            return fh.read().splitlines()
    except OSError as e:
        raise CmError("cannot read %s: %s" % (path, e))


def cmd_import_passwd(store, args):
    hid, _ = store.upsert_host(args.host, os_name="linux")
    kept, skipped = 0, 0
    skipped_names = []
    store.echo_enabled = False
    for line in _read_lines(args.file):
        if not line or line.startswith("#"):
            continue
        parts = line.split(":")
        if len(parts) < 7:
            continue
        name, _pw, uid, _gid, gecos, _home, shell = parts[:7]
        if shell.strip() in NOLOGIN_SHELLS:
            skipped += 1
            skipped_names.append(name)
            continue
        try:
            uid_i = int(uid)
        except ValueError:
            uid_i = None
        iid, _ = store.upsert_identity(name, "host", hid, uid=uid_i, shell=shell,
                                       description=gecos)
        store.add_observation("passwd", host_id=hid, identity_id=iid)
        kept += 1
    store.commit()
    store.echo_enabled = True
    c = store.c
    print("%s %d host user(s) on %s" % (c.bold("imported:"), kept, args.host))
    if skipped:
        print(c.dim("  skipped %d no-login account(s): %s" %
                    (skipped, ", ".join(skipped_names[:12]) + (" ..." if skipped > 12 else ""))))


def cmd_import_shadow(store, args):
    hid, _ = store.upsert_host(args.host, os_name="linux")
    attached, skipped = 0, 0
    store.echo_enabled = False
    for line in _read_lines(args.file):
        if not line or line.startswith("#"):
            continue
        parts = line.split(":")
        if len(parts) < 2:
            continue
        name, h = parts[0], parts[1]
        if not h or h[0] in "*!" or not h.startswith("$"):
            skipped += 1
            continue
        stype = None
        for prefix, t in SHADOW_PREFIXES:
            if h.startswith(prefix):
                stype = t
                break
        if stype is None:
            stype = "other"
        iid, _ = store.upsert_identity(name, "host", hid)
        sid, _ = store.upsert_secret(stype, h)
        store.link_identity_secret(iid, sid)
        store.add_observation("shadow", host_id=hid, identity_id=iid, secret_id=sid)
        attached += 1
    store.commit()
    store.echo_enabled = True
    c = store.c
    print("%s %d hash(es) attached on %s%s" %
          (c.bold("imported:"), attached, args.host,
           (c.dim("  (%d locked/absent skipped)" % skipped) if skipped else "")))


def cmd_import_ldap(store, args):
    import json
    try:
        with open(args.file, "r", errors="replace") as fh:
            data = json.load(fh)
    except (OSError, ValueError) as e:
        raise CmError("cannot parse %s as JSON: %s" % (args.file, e))
    if isinstance(data, list):
        entries = data
    elif isinstance(data, dict):
        entries = data.get("entries", data.get("users", []))
    else:
        raise CmError("cannot parse %s: expected a JSON list or object of LDAP entries" % args.file)
    did, _ = store.upsert_domain(args.domain)
    count = 0
    store.echo_enabled = False
    for e in entries:
        attrs = e.get("attributes", e) if isinstance(e, dict) else {}
        sam = attrs.get("sAMAccountName") or attrs.get("samaccountname") or attrs.get("cn")
        if isinstance(sam, list):
            sam = sam[0] if sam else None
        if not sam:
            continue
        desc = attrs.get("description")
        if isinstance(desc, list):
            desc = "; ".join(str(x) for x in desc)
        iid, _ = store.upsert_identity(str(sam), "domain", did, description=desc or "")
        store.add_observation("ldapdomaindump", identity_id=iid)
        count += 1
    store.commit()
    store.echo_enabled = True
    print("%s %d domain user(s) into %s" % (store.c.bold("imported:"), count, args.domain))


def cmd_import_secretsdump(store, args):
    """Parse impacket secretsdump / SAM / NTDS 'name:rid:lm:nt:::' lines."""
    if args.domain:
        realm = ("domain", args.domain)
    elif args.host:
        realm = ("host", args.host)
    else:
        raise CmError("secretsdump import needs --domain <fqdn> (NTDS) or --host <name> (SAM)")
    rtype, rid = store.resolve_place(realm)
    count = 0
    store.echo_enabled = False
    for line in _read_lines(args.file):
        line = line.strip()
        if not line or ":::" not in line:
            continue
        parts = line.split(":")
        if len(parts) < 4:
            continue
        name, _rid, lm, nt = parts[0], parts[1], parts[2], parts[3]
        if len(nt) != 32:
            continue
        # name may be DOMAIN\user
        uname = name.split("\\")[-1]
        iid, _ = store.upsert_identity(uname, rtype, rid)
        sid, _ = store.upsert_secret("ntlm", nt.lower())
        store.link_identity_secret(iid, sid)
        src = "ntds-dump" if rtype == "domain" else "sam-dump"
        store.add_observation(src, identity_id=iid, secret_id=sid)
        count += 1
    store.commit()
    store.echo_enabled = True
    print("%s %d NT hash(es)" % (store.c.bold("imported:"), count))


def cmd_import_nxc(store, args):
    """Parse NetExec/CrackMapExec console output lines with [+] successes."""
    count = 0
    store.echo_enabled = False
    for line in _read_lines(args.file):
        if "[+]" not in line:
            continue
        toks = line.split()
        if len(toks) < 2:
            continue
        proto = toks[0].lower()
        if proto not in PROTO_DEFAULTS:
            proto = toks[0].lower()
        # find the ip (second token) and hostname (token before [+] region if present)
        ip = toks[1]
        try:
            plus = toks.index("[+]")
        except ValueError:
            continue
        # nxc columns: PROTO IP PORT HOSTNAME [+] creds...  -> hostname at plus-1 (index 3)
        hostname = toks[plus - 1] if plus - 1 >= 3 else None
        cred = " ".join(toks[plus + 1:])
        pwned = "(Pwn3d!)" in cred
        cred = cred.replace("(Pwn3d!)", "").strip()
        if ":" not in cred:
            continue
        userpart, _, secret = cred.partition(":")
        secret = secret.strip()
        if "\\" in userpart:
            dom, user = userpart.split("\\", 1)
        else:
            dom, user = None, userpart
        # local vs domain: if the "domain" equals the hostname, it's a local account
        if dom and hostname and dom.lower() == hostname.lower():
            rtype, rid = store.resolve_place(("host", ip))
        elif dom:
            rtype, rid = store.resolve_place(("domain", dom))
        else:
            rtype, rid = store.resolve_place(("host", ip))
        iid, _ = store.upsert_identity(user, rtype, rid)
        # secret: 32-hex (optionally lm:nt) -> ntlm (lowercased, canonical), else plaintext
        sval = secret
        if ":" in secret and len(secret.split(":")[-1]) == 32:
            sval = secret.split(":")[-1].lower()
            stype = "ntlm"
        elif len(secret) == 32 and all(ch in "0123456789abcdefABCDEF" for ch in secret):
            stype = "ntlm"
            sval = secret.lower()
        else:
            stype = "plaintext"
        sid, _ = store.upsert_secret(stype, sval)
        store.link_identity_secret(iid, sid)
        hid, _ = store.upsert_host(ip)
        pdef = PROTO_DEFAULTS.get(proto, ("host", None))
        # nxc column 3 (toks[2]) is the real port - use it, not the proto default
        real_port = int(toks[2]) if len(toks) > 2 and toks[2].isdigit() else pdef[1]
        if pdef[0] == "service" and real_port:
            svid, _ = store.upsert_service(hid, real_port, "")
            store.upsert_access(iid, sid, "service", None, svid, protocol=proto,
                                privilege=("admin" if pwned else ""), status="valid")
        else:
            store.upsert_access(iid, sid, "host", hid, None, protocol=proto,
                                privilege=("local_admin" if pwned else "user"), status="valid")
        count += 1
    store.commit()
    store.echo_enabled = True
    print("%s %d valid login(s) from nxc output" % (store.c.bold("imported:"), count))


