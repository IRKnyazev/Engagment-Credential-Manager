def cmd_cred(store, args):
    username, rtype, rid = resolve_identity(store, args)
    spec = secret_from_args(args)
    if spec is None:
        raise CmError("cred needs a secret: --pass/--nt/--hash/--key/--pfx/--ticket "
                      "(use `cm add user` for a bare identity)")
    iid, _ = store.upsert_identity(username, rtype, rid,
                                   uid=getattr(args, "uid", None),
                                   shell=getattr(args, "shell", None),
                                   description=getattr(args, "desc", None))
    sid, _ = store.upsert_secret(*spec)
    store.link_identity_secret(iid, sid, origin=getattr(args, "origin", "discovered") or "discovered")
    if getattr(args, "src", None):
        store.add_observation(args.src, identity_id=iid, secret_id=sid)
    if getattr(args, "at", None):
        scope, hid, svid = resolve_target(store, args)
        status = getattr(args, "status", None) or "untested"
        store.upsert_access(iid, sid, scope, hid, svid,
                            protocol=(getattr(args, "proto", None) or ""),
                            privilege=(getattr(args, "priv", None) or ""),
                            status=status)
    store.commit()


def _works_fail(store, args, status):
    # split the (possibly comma-separated) target list first, and guard an
    # omitted --at cleanly (None.split would otherwise traceback). Use the first
    # target for realm inference so a --null session anchors to a real host, not
    # the comma-joined string.
    targets = [t.strip() for t in (args.at or "").split(",") if t.strip()]
    if not targets:
        raise CmError("--at HOST[:PORT] is required")
    args.at = targets[0]
    username, rtype, rid = resolve_identity(store, args)
    iid, _ = store.upsert_identity(username, rtype, rid)
    sid = pick_secret_for_identity(store, args, iid, status)
    store.link_identity_secret(iid, sid)
    for tgt in targets:
        args.at = tgt
        scope, hid, svid = resolve_target(store, args)
        store.upsert_access(iid, sid, scope, hid, svid,
                            protocol=(getattr(args, "proto", None) or ""),
                            privilege=(getattr(args, "priv", None) or ""),
                            status=status)
    if getattr(args, "src", None):
        store.add_observation(args.src, identity_id=iid, secret_id=sid)
    store.commit()


def cmd_works(store, args):
    _works_fail(store, args, "valid")


def cmd_fail(store, args):
    _works_fail(store, args, "invalid")


def cmd_reset(store, args):
    username, rtype, rid = resolve_identity(store, args)
    spec = secret_from_args(args)
    if spec is None:
        raise CmError("reset needs the new password/hash: --pass/--nt/--hash")
    iid, created = store.upsert_identity(username, rtype, rid)
    if not created:
        live = store.live_secrets_for_identity(iid)
        for s in live:
            store.conn.execute(
                "UPDATE identity_secrets SET superseded=1 WHERE identity_id=? AND secret_id=?",
                (iid, s["id"]))
            store.atom("-", "supersede %s <-> %s" % (store._ident_label_by_id(iid),
                                                     store.secret_short(s)))
    sid, _ = store.upsert_secret(*spec)
    store.link_identity_secret(iid, sid, origin="introduced")
    if getattr(args, "src", None):
        store.add_observation(args.src, identity_id=iid, secret_id=sid)
    store.commit()


def cmd_supersede(store, args):
    username, rtype, rid = resolve_identity(store, args, need_realm=True)
    ident = store.find_identity(username, rtype, rid)
    if not ident:
        raise CmError("no such identity: %s" % (args.identity or "(null)"))
    iid = ident["id"]
    if getattr(args, "secret", None):
        sid = store.resolve_secret_ref(args.secret)["id"]
    else:
        live = store.live_secrets_for_identity(iid)
        if len(live) == 1:
            sid = live[0]["id"]
        elif not live:
            raise CmError("identity has no live secrets to supersede")
        else:
            opts = ", ".join(store.secret_short(s) for s in live)
            raise CmError("several live secrets - pick with --secret: %s" % opts)
    row = store.conn.execute(
        "SELECT * FROM identity_secrets WHERE identity_id=? AND secret_id=?",
        (iid, sid)).fetchone()
    if not row:
        raise CmError("that secret is not linked to this identity")
    store.conn.execute("UPDATE identity_secrets SET superseded=1 WHERE id=?", (row["id"],))
    store.atom("-", "supersede %s <-> %s" % (store._ident_label_by_id(iid),
                                             store._secret_label_by_id(sid)))
    store.commit()


def cmd_cracked(store, args):
    # bulk from potfile / stdin, or a single ref + plaintext
    if getattr(args, "from_file", None) or getattr(args, "stdin", False):
        _cracked_bulk(store, args)
        return
    if not args.ref or args.plaintext is None:
        raise CmError("usage: cm cracked <hash-ref> --pass PLAINTEXT   |   "
                      "cm cracked --from file.potfile   |   cm cracked --stdin")
    hashrow = store.resolve_secret_ref(args.ref)
    _apply_crack(store, hashrow, args.plaintext)
    store.commit()


def _apply_crack(store, hashrow, plaintext):
    if hashrow["type"] == "plaintext":
        raise CmError("#%d is already a plaintext secret" % hashrow["id"])
    pt_id, created = store.upsert_secret("plaintext", plaintext)
    if not created:
        store.atom("=", "secret #%d plaintext %s (already present)" % (pt_id, mask(plaintext)))
    store.link_secrets(pt_id, hashrow["id"], "cracks")
    # propagate the plaintext to every owner of the hash, copying superseded state
    owners = store.conn.execute(
        "SELECT * FROM identity_secrets WHERE secret_id=?", (hashrow["id"],)).fetchall()
    for o in owners:
        existing = store.conn.execute(
            "SELECT * FROM identity_secrets WHERE identity_id=? AND secret_id=?",
            (o["identity_id"], pt_id)).fetchone()
        if not existing:
            store.conn.execute(
                "INSERT INTO identity_secrets(identity_id, secret_id, origin, superseded) "
                "VALUES(?,?,?,?)", (o["identity_id"], pt_id, o["origin"], o["superseded"]))
            tag = " (superseded)" if o["superseded"] else ""
            store.atom("+", "link %s <-> secret #%d plaintext%s" % (
                store._ident_label_by_id(o["identity_id"]), pt_id, tag))
        elif existing["superseded"] and not o["superseded"]:
            # another, still-live hash owned by this identity yields the same
            # plaintext - keep the derived plaintext link live (don't let a
            # first-cracked superseded hash pin it stale)
            store.conn.execute(
                "UPDATE identity_secrets SET superseded=0 WHERE id=?", (existing["id"],))
    return pt_id


def _cracked_bulk(store, args):
    if getattr(args, "stdin", False):
        lines = sys.stdin.read().splitlines()
        source = "<stdin>"
    else:
        try:
            with open(args.from_file, "r", errors="replace") as fh:
                lines = fh.read().splitlines()
        except OSError as e:
            raise CmError("cannot read %s: %s" % (args.from_file, e))
        source = args.from_file
    # all crackable hashes currently stored, longest value first (so we match the
    # most specific hash when one value is a prefix of another)
    hashes = store.conn.execute(
        "SELECT * FROM secrets WHERE type!='plaintext' AND type NOT IN "
        "('ssh_private_key','certificate_pfx','kerberos_ticket') "
        "ORDER BY length(value) DESC").fetchall()
    # pre-lower the hash prefixes once: hashcat potfiles are lowercase hex and the
    # user/domain label in NetNTLM strings varies in case, while the stored value
    # may be uppercase. The hash portion is case-insensitive; the PASSWORD (after
    # the hash) is not, so we only fold case on the prefix and slice the plaintext
    # from the original line.
    lowered = [(h, (h["value"] + ":").lower()) for h in hashes]
    new_links = 0
    already = 0
    skipped = []
    store.echo_enabled = False  # keep bulk quiet; print a summary instead
    for raw in lines:
        line = raw.rstrip("\n")
        if not line:
            continue
        matched = None
        plaintext = None
        low = line.lower()
        for h, pfx in lowered:
            if low.startswith(pfx):
                matched = h
                plaintext = line[len(h["value"]) + 1:]
                break
        if matched is None:
            skipped.append(line)
            continue
        existing = store.conn.execute(
            "SELECT sl.id FROM secret_links sl JOIN secrets s ON s.id=sl.from_secret_id "
            "WHERE sl.to_secret_id=? AND sl.relation='cracks' AND s.type='plaintext' AND s.value=?",
            (matched["id"], plaintext)).fetchone()
        if existing:
            already += 1
            continue
        _apply_crack(store, matched, plaintext)
        new_links += 1
    store.commit()
    store.echo_enabled = True
    c = store.c
    print("%s %s" % (c.bold("cracked:"), source))
    print("  %s new, %s already linked" % (c.green(str(new_links)), c.dim(str(already))))
    if skipped:
        print(c.yellow("  %d cracked hash(es) not in db - did you forget to add them?" % len(skipped)))
        for s in skipped:
            print("    " + s)


def cmd_unlock(store, args):
    # resolve the protected secret (key/pfx) and the passphrase plaintext
    ref = args.key or args.pfx or args.secret
    if not ref:
        raise CmError("unlock needs --key/--pfx/--secret <ref>")
    protected = store.resolve_secret_ref(ref)
    if args.passphrase is None and not args.with_secret:
        raise CmError("give --passphrase VALUE (or --with <plaintext-ref>)")
    if args.with_secret:
        pt = store.resolve_secret_ref(args.with_secret)
        if pt["type"] != "plaintext":
            raise CmError("--with must reference a plaintext secret")
        pt_id = pt["id"]
    else:
        pt_id, _ = store.upsert_secret("plaintext", args.passphrase)
    store.link_secrets(pt_id, protected["id"], "unlocks")
    store.note("[note: passphrase links to the key, not to any login]")
    store.commit()


