def cmd_users(store, args):
    q = "SELECT * FROM identities"
    where, params = [], []
    if getattr(args, "domain", None):
        where.append("realm_type='domain' AND realm_id=(SELECT id FROM domains WHERE fqdn=?)")
        params.append(args.domain)
    if getattr(args, "host", None):
        where.append("realm_type='host' AND realm_id=(SELECT id FROM hosts WHERE name=?)")
        params.append(args.host)
    if getattr(args, "realm", None):
        where.append("realm_type=?")
        params.append(args.realm)
    if where:
        q += " WHERE " + " AND ".join(where)
    q += " ORDER BY realm_type, username"
    rows = store.conn.execute(q, params).fetchall()
    for r in rows:
        print(store.identity_label_row(r))
    if not rows:
        print(store.c.dim("(no identities)"))


def cmd_hashes(store, args):
    stype = getattr(args, "type", None)
    if stype and stype not in SECRET_TYPES:
        raise CmError("unknown type %r" % stype)
    q = "SELECT * FROM secrets WHERE 1=1"
    params = []
    if stype:
        q += " AND type=?"
        params.append(stype)
    else:
        q += " AND type IN (%s)" % ",".join("?" * len(CRACKABLE_TYPES))
        params.extend(sorted(CRACKABLE_TYPES))
    rows = store.conn.execute(q + " ORDER BY type, id", params).fetchall()
    for r in rows:
        if r["type"] in BLOB_TYPES:
            continue
        print("#%d\t%s\t%s" % (r["id"], r["type"], r["value"]))
    if not rows:
        print(store.c.dim("(no hashes)"))


def cmd_todo_crack(store, args):
    # crackable, not yet cracked, and still live (ownerless OR >=1 non-superseded link)
    rows = store.conn.execute(
        "SELECT s.* FROM secrets s "
        "WHERE s.type IN (%s) "
        "AND NOT EXISTS (SELECT 1 FROM secret_links sl "
        "                WHERE sl.to_secret_id=s.id AND sl.relation='cracks') "
        "AND ( (SELECT COUNT(*) FROM identity_secrets il WHERE il.secret_id=s.id)=0 "
        "      OR EXISTS (SELECT 1 FROM identity_secrets il "
        "                 WHERE il.secret_id=s.id AND il.superseded=0) ) "
        "ORDER BY s.type, s.id" % ",".join("?" * len(CRACKABLE_TYPES)),
        sorted(CRACKABLE_TYPES)).fetchall()
    for r in rows:
        print("#%d\t%s\t%s" % (r["id"], r["type"], r["value"]))
    if not rows:
        print(store.c.dim("(nothing left to crack)"))


def cmd_where(store, args):
    if getattr(args, "user", None) or getattr(args, "null", False):
        args.identity = getattr(args, "user", None)
        username, rtype, rid = resolve_identity(store, args)
        ident = store.find_identity(username, rtype, rid)
        if not ident:
            raise CmError("no such identity")
        rows = store.conn.execute(
            "SELECT * FROM accesses WHERE identity_id=? ORDER BY status, scope", (ident["id"],)).fetchall()
        print(store.c.bold("accesses for %s:" % store.identity_label_row(ident)))
        _print_accesses(store, rows, show_user=False)
    elif getattr(args, "host", None):
        host, port = split_host_port(args.host)
        hrow = store.conn.execute("SELECT * FROM hosts WHERE name=?", (host,)).fetchone()
        if not hrow:
            raise CmError("no such host: %s" % host)
        rows = store.conn.execute(
            "SELECT a.* FROM accesses a LEFT JOIN services s ON s.id=a.service_id "
            "WHERE a.host_id=? OR s.host_id=? ORDER BY a.status", (hrow["id"], hrow["id"])).fetchall()
        print(store.c.bold("accesses on %s:" % host))
        _print_accesses(store, rows, show_user=True)
    else:
        # engagement-wide listing (for lateral-movement planning / reporting)
        q = "SELECT * FROM accesses"
        if getattr(args, "valid", False):
            q += " WHERE status='valid'"
        q += " ORDER BY status, scope"
        rows = store.conn.execute(q).fetchall()
        print(store.c.bold("valid accesses:" if getattr(args, "valid", False) else "all accesses:"))
        _print_accesses(store, rows, show_user=True)


def _print_accesses(store, rows, show_user):
    if not rows:
        print(store.c.dim("  (none)"))
        return
    for a in rows:
        tgt = store._target_label(a["scope"], a["host_id"], a["service_id"])
        proto = (a["protocol"] + "/") if a["protocol"] else ""
        bits = []
        if a["privilege"]:
            bits.append(a["privilege"])
        status = a["status"]
        col = {"valid": store.c.green, "invalid": store.c.red,
               "untested": store.c.yellow, "expired": store.c.dim}.get(status, store.c.dim)
        head = store.identity_label_row(
            store.conn.execute("SELECT * FROM identities WHERE id=?", (a["identity_id"],)).fetchone()) + "  " if show_user else ""
        print("  %s%s%s  %s%s" % (head, proto, tgt, col(status),
                                  ("  [" + ", ".join(bits) + "]") if bits else ""))


def cmd_show(store, args):
    if args.kind == "user":
        args.identity = args.name
        username, rtype, rid = resolve_identity(store, args)
        ident = store.find_identity(username, rtype, rid)
        if not ident:
            raise CmError("no such identity: %s" % args.name)
        _show_identity(store, ident)
    elif args.kind == "secret":
        row = store.resolve_secret_ref(args.name)
        _show_secret(store, row)
    else:
        raise CmError("show user <ident> | show secret <ref>")


def _show_identity(store, ident):
    c = store.c
    print(c.bold(store.identity_label_row(ident)))
    if ident["description"]:
        print("  description: " + ident["description"])
    if ident["uid"] is not None or ident["shell"]:
        print("  uid=%s shell=%s" % (ident["uid"], ident["shell"]))
    secs = store.conn.execute(
        "SELECT il.*, s.type AS stype, s.value AS sval, s.id AS sid FROM identity_secrets il "
        "JOIN secrets s ON s.id=il.secret_id WHERE il.identity_id=? ORDER BY il.superseded",
        (ident["id"],)).fetchall()
    print("  secrets:")
    if not secs:
        print(c.dim("    (none)"))
    for s in secs:
        flags = []
        if s["origin"] == "introduced":
            flags.append("introduced")
        if s["superseded"]:
            flags.append(c.yellow("superseded"))
        val = "(blob)" if s["stype"] in BLOB_TYPES else s["sval"]
        print("    #%d %s %s%s" % (s["sid"], s["stype"], val,
                                   ("  [" + ", ".join(flags) + "]") if flags else ""))
    accs = store.conn.execute(
        "SELECT * FROM accesses WHERE identity_id=? ORDER BY status", (ident["id"],)).fetchall()
    print("  accesses:")
    _print_accesses(store, accs, show_user=False) if accs else print(c.dim("    (none)"))
    obs = store.conn.execute(
        "SELECT * FROM observations WHERE identity_id=? ORDER BY found_at", (ident["id"],)).fetchall()
    if obs:
        print("  found via: " + ", ".join(o["method"] for o in obs if o["method"]))


def _show_secret(store, row):
    c = store.c
    val = "(blob: %s)" % (row["filename"] or "file") if row["type"] in BLOB_TYPES else row["value"]
    print(c.bold("#%d %s" % (row["id"], row["type"])) + "  " + val)
    if row["expires_at"]:
        print("  expires: " + row["expires_at"])
    owners = store.conn.execute(
        "SELECT i.*, il.origin, il.superseded FROM identity_secrets il "
        "JOIN identities i ON i.id=il.identity_id WHERE il.secret_id=?", (row["id"],)).fetchall()
    if owners:
        print("  owners:")
        for o in owners:
            flags = []
            if o["origin"] == "introduced":
                flags.append("introduced")
            if o["superseded"]:
                flags.append("superseded")
            print("    %s%s" % (store.identity_label_row(o),
                                ("  [" + ", ".join(flags) + "]") if flags else ""))
    links = store.conn.execute(
        "SELECT sl.relation, s.id AS sid, s.type AS st, s.value AS sv FROM secret_links sl "
        "JOIN secrets s ON s.id=sl.from_secret_id WHERE sl.to_secret_id=?", (row["id"],)).fetchall()
    for l in links:
        print("  %s by #%d %s %s" % (l["relation"], l["sid"], l["st"], mask(l["sv"])))


def cmd_stats(store, args):
