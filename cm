def cmd_export(store, args):
    what = args.what
    if what == "users":
        rows = _export_user_rows(store, args)
        out = sorted(set(r["username"] for r in rows if r["username"] != ""))
        print("\n".join(out))
    elif what == "passwords":
        rows = store.conn.execute(
            "SELECT DISTINCT value FROM secrets WHERE type='plaintext'").fetchall()
        print("\n".join(sorted(set(r["value"] for r in rows))))
    elif what == "pairs":
        stype = getattr(args, "type", None) or "plaintext"
        if stype not in SECRET_TYPES:
            raise CmError("unknown type %r" % stype)
        q = ("SELECT i.username AS u, s.value AS v FROM identity_secrets il "
             "JOIN identities i ON i.id=il.identity_id "
             "JOIN secrets s ON s.id=il.secret_id WHERE s.type=?")
        params = [stype]
        if getattr(args, "introduced", False):
            q += " AND il.origin='introduced'"
        if not getattr(args, "all", False):
            q += " AND il.superseded=0"
        rows = store.conn.execute(q, params).fetchall()
        out = sorted(set("%s:%s" % (r["u"], r["v"]) for r in rows))
        print("\n".join(out))
    elif what == "hashes":
        stype = getattr(args, "type", None)
        if not stype:
            raise CmError("export hashes needs --type TYPE")
        if stype not in SECRET_TYPES:
            raise CmError("unknown type %r" % stype)
        rows = store.conn.execute(
            "SELECT DISTINCT value FROM secrets WHERE type=?", (stype,)).fetchall()
        print("\n".join(r["value"] for r in rows))
    elif what == "key":
        if not args.ref:
            raise CmError("export key needs a secret ref (e.g. #5)")
        row = store.resolve_secret_ref(args.ref)
        if row["type"] not in BLOB_TYPES:
            raise CmError("#%d is not a key/pfx/ticket blob" % row["id"])
        try:
            blob = base64.b64decode(row["value"], validate=True)
        except Exception as e:  # binascii.Error (a ValueError) on a non-base64 value
            raise CmError("secret #%d does not hold a valid base64 blob (%s)" % (row["id"], e))
        sys.stdout.buffer.write(blob)
    else:
        raise CmError("export users|passwords|pairs|hashes|key")


def _export_user_rows(store, args):
    q = "SELECT * FROM identities"
    where, params = [], []
    if getattr(args, "domain", None):
        where.append("realm_type='domain' AND realm_id=(SELECT id FROM domains WHERE fqdn=?)")
        params.append(args.domain)
    if getattr(args, "host", None):
        where.append("realm_type='host' AND realm_id=(SELECT id FROM hosts WHERE name=?)")
        params.append(args.host)
    if where:
        q += " WHERE " + " AND ".join(where)
    return store.conn.execute(q, params).fetchall()


