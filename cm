def _use_color():
    return sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


class C:
    def __init__(self, on):
        self.on = on

    def _w(self, code, s):
        return "\033[%sm%s\033[0m" % (code, s) if self.on else s

    def dim(self, s):   return self._w("2", s)
    def green(self, s): return self._w("32", s)
    def yellow(self, s):return self._w("33", s)
    def cyan(self, s):  return self._w("36", s)
    def red(self, s):   return self._w("31", s)
    def bold(self, s):  return self._w("1", s)


# --------------------------------------------------------------------------
# schema
# --------------------------------------------------------------------------

SCHEMA = """
PRAGMA foreign_keys = ON;

CREATE TABLE IF NOT EXISTS domains (
    id    INTEGER PRIMARY KEY,
    fqdn  TEXT NOT NULL UNIQUE COLLATE NOCASE,
    notes TEXT NOT NULL DEFAULT ''
);

CREATE TABLE IF NOT EXISTS hosts (
    id    INTEGER PRIMARY KEY,
    name  TEXT NOT NULL UNIQUE COLLATE NOCASE,
    os    TEXT,
    notes TEXT NOT NULL DEFAULT ''
);

CREATE TABLE IF NOT EXISTS services (
    id      INTEGER PRIMARY KEY,
    host_id INTEGER NOT NULL REFERENCES hosts(id) ON DELETE CASCADE,
    port    INTEGER NOT NULL,
    service TEXT NOT NULL DEFAULT '',
    notes   TEXT NOT NULL DEFAULT '',
    UNIQUE(host_id, port, service)
);

CREATE TABLE IF NOT EXISTS identities (
    id          INTEGER PRIMARY KEY,
    username    TEXT NOT NULL,
    realm_type  TEXT NOT NULL CHECK(realm_type IN ('domain','host','service','unknown')),
    realm_id    INTEGER NOT NULL DEFAULT 0,
    uid         INTEGER,
    shell       TEXT,
    description TEXT NOT NULL DEFAULT '',
    notes       TEXT NOT NULL DEFAULT '',
    UNIQUE(username, realm_type, realm_id)
);

CREATE TABLE IF NOT EXISTS secrets (
    id         INTEGER PRIMARY KEY,
    type       TEXT NOT NULL CHECK(type IN (
        'plaintext','ntlm','lm','netntlmv1','netntlmv2','kerberos_tgs',
        'kerberos_asrep','dcc2','sha512crypt','sha256crypt','md5crypt',
        'bcrypt','yescrypt','ssh_private_key','certificate_pfx',
        'kerberos_ticket','other')),
    value      TEXT NOT NULL,
    label      TEXT NOT NULL DEFAULT '',
    filename   TEXT,
    expires_at TEXT,
    notes      TEXT NOT NULL DEFAULT '',
    UNIQUE(type, value)
);

CREATE TABLE IF NOT EXISTS identity_secrets (
    id          INTEGER PRIMARY KEY,
    identity_id INTEGER NOT NULL REFERENCES identities(id) ON DELETE CASCADE,
    secret_id   INTEGER NOT NULL REFERENCES secrets(id) ON DELETE CASCADE,
    origin      TEXT NOT NULL DEFAULT 'discovered' CHECK(origin IN ('discovered','introduced')),
    superseded  INTEGER NOT NULL DEFAULT 0 CHECK(superseded IN (0,1)),
    notes       TEXT NOT NULL DEFAULT '',
    UNIQUE(identity_id, secret_id)
);

CREATE TABLE IF NOT EXISTS secret_links (
    id             INTEGER PRIMARY KEY,
    from_secret_id INTEGER NOT NULL REFERENCES secrets(id) ON DELETE CASCADE,
    to_secret_id   INTEGER NOT NULL REFERENCES secrets(id) ON DELETE CASCADE,
    relation       TEXT NOT NULL CHECK(relation IN ('cracks','unlocks')),
    UNIQUE(from_secret_id, to_secret_id, relation)
);

CREATE TABLE IF NOT EXISTS accesses (
    id          INTEGER PRIMARY KEY,
    identity_id INTEGER NOT NULL REFERENCES identities(id) ON DELETE CASCADE,
    secret_id   INTEGER NOT NULL REFERENCES secrets(id) ON DELETE CASCADE,
    host_id     INTEGER REFERENCES hosts(id) ON DELETE CASCADE,
    service_id  INTEGER REFERENCES services(id) ON DELETE CASCADE,
    scope       TEXT NOT NULL CHECK(scope IN ('host','service')),
    protocol    TEXT NOT NULL DEFAULT '',
    privilege   TEXT NOT NULL DEFAULT '',
    status      TEXT NOT NULL DEFAULT 'untested' CHECK(status IN ('valid','invalid','untested','expired')),
    notes       TEXT NOT NULL DEFAULT '',
    CHECK ((scope='host'    AND host_id    IS NOT NULL AND service_id IS NULL) OR
           (scope='service' AND service_id IS NOT NULL AND host_id    IS NULL)),
    UNIQUE(identity_id, secret_id, host_id, service_id, protocol)
);

CREATE TABLE IF NOT EXISTS observations (
    id          INTEGER PRIMARY KEY,
    found_at    TEXT NOT NULL,
    method      TEXT NOT NULL DEFAULT '',
    host_id     INTEGER REFERENCES hosts(id) ON DELETE SET NULL,
    identity_id INTEGER REFERENCES identities(id) ON DELETE CASCADE,
    secret_id   INTEGER REFERENCES secrets(id) ON DELETE CASCADE,
    notes       TEXT NOT NULL DEFAULT '',
    CHECK (identity_id IS NOT NULL OR secret_id IS NOT NULL)
);

CREATE UNIQUE INDEX IF NOT EXISTS ux_obs
    ON observations(method, IFNULL(host_id,0), IFNULL(identity_id,0), IFNULL(secret_id,0));
"""


# --------------------------------------------------------------------------
# parsing helpers
# --------------------------------------------------------------------------

def split_host_port(s):
    """'10.0.0.5:1433' -> ('10.0.0.5', 1433); '10.0.0.5' -> ('10.0.0.5', None)."""
    s = s.strip()
    if ":" in s:
        host, _, port = s.rpartition(":")
        if port.isdigit():
            return host, int(port)
    return s, None


def parse_principal(token):
    """Parse a principal token into (username, realm_hint).

    realm_hint is one of:
        ('domain', fqdn)
        ('host', name)
        ('service', host, port)
        (None,)           -> no realm encoded in the token

    Rules:
        DOMAIN\\user          -> domain  (backslash means a Windows domain logon)
        user@host             -> host    (the unambiguous local-account form)
        user@host:port        -> service (that specific service)
        user                  -> no realm encoded (caller supplies --realm)
    """
    if "\\" in token:
        left, _, user = token.partition("\\")
        return user, ("domain", left)
    if "@" in token:
        user, _, right = token.rpartition("@")
        host, port = split_host_port(right)
        if port is not None:
            return user, ("service", host, port)
        return user, ("host", host)
    return token, (None,)


def parse_realm_opt(spec):
    """Parse --realm 'domain:X' / 'host:X' / 'service:HOST:PORT'."""
    kind, _, rest = spec.partition(":")
    kind = kind.lower()
    if kind == "domain":
        if not rest:
            raise CmError("--realm domain:<fqdn> needs a domain")
        return ("domain", rest)
    if kind == "host":
        if not rest:
            raise CmError("--realm host:<name> needs a host")
        return ("host", rest)
    if kind == "service":
        host, port = split_host_port(rest)
        if port is None:
            raise CmError("--realm service:<host>:<port> needs host and port")
        return ("service", host, port)
    raise CmError("--realm must be domain:X, host:X or service:HOST:PORT")


# --------------------------------------------------------------------------
# store: db connection + atomic operations (each echoes what it did)
# --------------------------------------------------------------------------

class Store:
    def __init__(self, path, color, echo=True):
        self.path = path
        self.c = color
        self.echo_enabled = echo
        new = not os.path.exists(path)
        self.conn = sqlite3.connect(path)
        self.conn.row_factory = sqlite3.Row
        self.conn.execute("PRAGMA foreign_keys = ON")
        self.conn.executescript(SCHEMA)
        self.conn.commit()
        self._was_new = new
        self._buf = []  # echoes are buffered and flushed only on a successful commit

    # -- output -------------------------------------------------------------
    def atom(self, verb, text):
        """Queue one underlying atomic step (teaching aid). Flushed on commit()."""
        if not self.echo_enabled:
            return
        mark = {"+": self.c.green("+"), "~": self.c.yellow("~"),
                "=": self.c.dim("="), "-": self.c.yellow("-")}.get(verb, verb)
        line = "  %s %s" % (mark, text)
        if verb == "=":
            line = self.c.dim(line)
        self._buf.append(line)

    def note(self, text):
        """Queue an assumption / informational line. Flushed on commit()."""
        if self.echo_enabled:
            self._buf.append(self.c.cyan(text))

    def commit(self):
        # persist first, then show the user exactly what was committed
        self.conn.commit()
        for line in self._buf:
            print(line)
        self._buf = []

    # -- places -------------------------------------------------------------
    def upsert_domain(self, fqdn):
        row = self.conn.execute("SELECT * FROM domains WHERE fqdn=?", (fqdn,)).fetchone()
        if row:
            return row["id"], False
        cur = self.conn.execute("INSERT INTO domains(fqdn) VALUES(?)", (fqdn,))
        self.atom("+", "domain %s" % fqdn)
        return cur.lastrowid, True

    def upsert_host(self, name, os_name=None):
        row = self.conn.execute("SELECT * FROM hosts WHERE name=?", (name,)).fetchone()
        if row:
            if os_name and not row["os"]:
                self.conn.execute("UPDATE hosts SET os=? WHERE id=?", (os_name, row["id"]))
                self.atom("~", "host %s (os=%s)" % (name, os_name))
            return row["id"], False
        cur = self.conn.execute("INSERT INTO hosts(name, os) VALUES(?,?)", (name, os_name))
        self.atom("+", "host %s" % name + ((" (os=%s)" % os_name) if os_name else ""))
        return cur.lastrowid, True

    def upsert_service(self, host_id, port, service=""):
        row = self.conn.execute(
            "SELECT * FROM services WHERE host_id=? AND port=? AND service=?",
            (host_id, port, service)).fetchone()
        if row:
            return row["id"], False
        cur = self.conn.execute(
            "INSERT INTO services(host_id, port, service) VALUES(?,?,?)",
            (host_id, port, service))
        hn = self._host_name(host_id)
        self.atom("+", "service %s:%d%s" % (hn, port, (" (%s)" % service) if service else ""))
        return cur.lastrowid, True

    def _host_name(self, host_id):
        r = self.conn.execute("SELECT name FROM hosts WHERE id=?", (host_id,)).fetchone()
        return r["name"] if r else "?"

    def resolve_place(self, realm_hint, service_name=""):
        """Turn a realm hint into (realm_type, realm_id), creating places."""
        kind = realm_hint[0]
        if kind == "domain":
            did, _ = self.upsert_domain(realm_hint[1])
            return "domain", did
        if kind == "host":
            hid, _ = self.upsert_host(realm_hint[1])
            return "host", hid
        if kind == "service":
            hid, _ = self.upsert_host(realm_hint[1])
            sid, _ = self.upsert_service(hid, realm_hint[2], service_name)
            return "service", sid
        return "unknown", 0

    # -- identities ---------------------------------------------------------
    def upsert_identity(self, username, realm_type, realm_id,
                        uid=None, shell=None, description=None):
        row = self.conn.execute(
            "SELECT * FROM identities WHERE username=? AND realm_type=? AND realm_id=?",
            (username, realm_type, realm_id)).fetchone()
        label = self.identity_label(username, realm_type, realm_id)
        if row:
            sets, vals = [], []
            if uid is not None and row["uid"] is None:
                sets.append("uid=?"); vals.append(uid)
            if shell is not None and not row["shell"]:
                sets.append("shell=?"); vals.append(shell)
            if description and not row["description"]:
                sets.append("description=?"); vals.append(description)
            if sets:
                vals.append(row["id"])
                self.conn.execute("UPDATE identities SET %s WHERE id=?" % ",".join(sets), vals)
                self.atom("~", "user %s (metadata)" % label)
            return row["id"], False
        cur = self.conn.execute(
            "INSERT INTO identities(username, realm_type, realm_id, uid, shell, description) "
            "VALUES(?,?,?,?,?,?)",
            (username, realm_type, realm_id, uid, shell, description or ""))
        self.atom("+", "user %s" % label)
        return cur.lastrowid, True

    def identity_label(self, username, realm_type, realm_id):
        uname = username if username != "" else "(null)"
        if realm_type == "domain":
            r = self.conn.execute("SELECT fqdn FROM domains WHERE id=?", (realm_id,)).fetchone()
            return "%s\\%s" % (r["fqdn"] if r else "?", uname)
        if realm_type == "host":
            return "%s@%s" % (uname, self._host_name(realm_id))
        if realm_type == "service":
            r = self.conn.execute(
                "SELECT h.name AS hn, s.port AS p FROM services s "
                "JOIN hosts h ON h.id=s.host_id WHERE s.id=?", (realm_id,)).fetchone()
            if r:
                return "%s@%s:%d" % (uname, r["hn"], r["p"])
            return uname
        return uname

    def identity_label_row(self, ident):
        return self.identity_label(ident["username"], ident["realm_type"], ident["realm_id"])

    # -- secrets ------------------------------------------------------------
    def upsert_secret(self, stype, value, label="", filename=None, expires=None):
        row = self.conn.execute(
            "SELECT * FROM secrets WHERE type=? AND value=?", (stype, value)).fetchone()
        if row:
            sets, vals = [], []
            if expires and not row["expires_at"]:
                sets.append("expires_at=?"); vals.append(expires)
            if filename and not row["filename"]:
                sets.append("filename=?"); vals.append(filename)
            if label and not row["label"]:
                sets.append("label=?"); vals.append(label)
            if sets:
                vals.append(row["id"])
                self.conn.execute("UPDATE secrets SET %s WHERE id=?" % ",".join(sets), vals)
            return row["id"], False
        cur = self.conn.execute(
            "INSERT INTO secrets(type, value, label, filename, expires_at) VALUES(?,?,?,?,?)",
            (stype, value, label, filename, expires))
        self.atom("+", "secret #%d %s%s" % (cur.lastrowid, stype, self._secret_tag(stype, value)))
        return cur.lastrowid, True

    def _secret_tag(self, stype, value):
        if stype in BLOB_TYPES:
            return " (blob)"
        return " %s" % mask(value)

    def secret_short(self, srow):
        return "#%d %s %s" % (srow["id"], srow["type"],
                              "(blob)" if srow["type"] in BLOB_TYPES else mask(srow["value"]))

    # -- links --------------------------------------------------------------
    def link_identity_secret(self, identity_id, secret_id, origin="discovered",
                             superseded=0):
        row = self.conn.execute(
            "SELECT * FROM identity_secrets WHERE identity_id=? AND secret_id=?",
            (identity_id, secret_id)).fetchone()
        ilabel = self._ident_label_by_id(identity_id)
        slabel = self._secret_label_by_id(secret_id)
        if row:
            if origin == "introduced" and row["origin"] != "introduced":
                self.conn.execute("UPDATE identity_secrets SET origin='introduced' WHERE id=?",
                                  (row["id"],))
                self.atom("~", "link %s <-> %s (origin=introduced)" % (ilabel, slabel))
            else:
                self.atom("=", "link %s <-> %s" % (ilabel, slabel))
            return row["id"], False
        cur = self.conn.execute(
            "INSERT INTO identity_secrets(identity_id, secret_id, origin, superseded) "
            "VALUES(?,?,?,?)", (identity_id, secret_id, origin, superseded))
        extra = " origin=introduced" if origin == "introduced" else ""
        self.atom("+", "link %s <-> %s%s" % (ilabel, slabel, extra))
        # If this secret was ALREADY cracked, back-link the plaintext too, so a
        # hash owner discovered after the crack still shows its password in
        # export pairs / show. (A plaintext is never the to-side of a 'cracks'
        # link, so this recurses at most one level.)
        for cr in self.conn.execute(
                "SELECT from_secret_id FROM secret_links WHERE to_secret_id=? AND relation='cracks'",
                (secret_id,)).fetchall():
            self.link_identity_secret(identity_id, cr["from_secret_id"],
                                      origin=origin, superseded=superseded)
        return cur.lastrowid, True

    def link_secrets(self, from_id, to_id, relation):
        row = self.conn.execute(
            "SELECT * FROM secret_links WHERE from_secret_id=? AND to_secret_id=? AND relation=?",
            (from_id, to_id, relation)).fetchone()
        if row:
            self.atom("=", "%s %s -> %s" % (relation, self._secret_label_by_id(from_id),
                                            self._secret_label_by_id(to_id)))
            return row["id"], False
        cur = self.conn.execute(
            "INSERT INTO secret_links(from_secret_id, to_secret_id, relation) VALUES(?,?,?)",
            (from_id, to_id, relation))
        self.atom("+", "%s %s -> %s" % (relation, self._secret_label_by_id(from_id),
                                        self._secret_label_by_id(to_id)))
        return cur.lastrowid, True

    def _ident_label_by_id(self, identity_id):
        r = self.conn.execute("SELECT * FROM identities WHERE id=?", (identity_id,)).fetchone()
        return self.identity_label_row(r) if r else "?"

    def _secret_label_by_id(self, secret_id):
        r = self.conn.execute("SELECT * FROM secrets WHERE id=?", (secret_id,)).fetchone()
        return self.secret_short(r) if r else "?"

    # -- accesses -----------------------------------------------------------
    def upsert_access(self, identity_id, secret_id, scope, host_id, service_id,
                      protocol="", privilege="", status="untested"):
        row = self.conn.execute(
            "SELECT * FROM accesses WHERE identity_id=? AND secret_id=? AND "
            "IFNULL(host_id,0)=IFNULL(?,0) AND IFNULL(service_id,0)=IFNULL(?,0) AND protocol=?",
            (identity_id, secret_id, host_id, service_id, protocol)).fetchone()
        tgt = self._target_label(scope, host_id, service_id)
        ilabel = self._ident_label_by_id(identity_id)
        if row:
            sets, vals, changed = [], [], []
            if status != row["status"]:
                sets.append("status=?"); vals.append(status); changed.append("status=%s" % status)
            if privilege and privilege != row["privilege"]:
                sets.append("privilege=?"); vals.append(privilege); changed.append("priv=%s" % privilege)
            if sets:
                vals.append(row["id"])
                self.conn.execute("UPDATE accesses SET %s WHERE id=?" % ",".join(sets), vals)
                self.atom("~", "access %s -> %s [%s]" % (ilabel, tgt, ", ".join(changed)))
            else:
                self.atom("=", "access %s -> %s" % (ilabel, tgt))
            return row["id"], False
        cur = self.conn.execute(
            "INSERT INTO accesses(identity_id, secret_id, host_id, service_id, scope, "
            "protocol, privilege, status) VALUES(?,?,?,?,?,?,?,?)",
            (identity_id, secret_id, host_id, service_id, scope, protocol, privilege, status))
        bits = status
        if privilege:
            bits += ", " + privilege
        if protocol:
            tgt = "%s/%s" % (protocol, tgt)
        self.atom("+", "access %s -> %s [%s]" % (ilabel, tgt, bits))
        return cur.lastrowid, True

    def _target_label(self, scope, host_id, service_id):
        if scope == "service" and service_id:
            r = self.conn.execute(
                "SELECT h.name AS hn, s.port AS p, s.service AS sv FROM services s "
                "JOIN hosts h ON h.id=s.host_id WHERE s.id=?", (service_id,)).fetchone()
            if r:
                return "%s:%d" % (r["hn"], r["p"])
        if host_id:
            return self._host_name(host_id)
        return "?"

    # -- observations -------------------------------------------------------
    def add_observation(self, method, host_id=None, identity_id=None, secret_id=None):
        if identity_id is None and secret_id is None:
            return
        try:
            self.conn.execute(
                "INSERT INTO observations(found_at, method, host_id, identity_id, secret_id) "
                "VALUES(?,?,?,?,?)",
                (now_iso(), method, host_id, identity_id, secret_id))
            self.atom("+", "observation %s" % (method or "(note)"))
        except sqlite3.IntegrityError:
            pass  # duplicate observation -> idempotent no-op

    # -- resolvers ----------------------------------------------------------
    def resolve_secret_ref(self, ref):
        """Resolve a secret reference: '#id', 'type:valueprefix', or value prefix."""
        ref = ref.strip()
        if ref.startswith("#"):
            try:
                sid = int(ref[1:])
            except ValueError:
                raise CmError("bad secret id %r" % ref)
            row = self.conn.execute("SELECT * FROM secrets WHERE id=?", (sid,)).fetchone()
            if not row:
                raise CmError("no secret #%d" % sid)
            return row
        stype = None
        needle = ref
        head, sep, rest = ref.partition(":")
        if sep and head in SECRET_TYPES:
            stype, needle = head, rest
        # exact value match first
        if stype:
            rows = self.conn.execute(
                "SELECT * FROM secrets WHERE type=? AND value=?", (stype, needle)).fetchall()
        else:
            rows = self.conn.execute("SELECT * FROM secrets WHERE value=?", (needle,)).fetchall()
        if len(rows) == 1:
            return rows[0]
        # prefix match
        like = needle.replace("%", r"\%").replace("_", r"\_") + "%"
        if stype:
            rows = self.conn.execute(
                "SELECT * FROM secrets WHERE type=? AND value LIKE ? ESCAPE '\\'",
                (stype, like)).fetchall()
        else:
            rows = self.conn.execute(
                "SELECT * FROM secrets WHERE value LIKE ? ESCAPE '\\'", (like,)).fetchall()
        if len(rows) == 1:
            return rows[0]
        if not rows:
            raise CmError("no secret matches %r (try #id, or `cm hashes`)" % ref)
        opts = ", ".join("#%d %s" % (r["id"], r["type"]) for r in rows[:8])
        raise CmError("ambiguous secret %r - matches: %s (use #id)" % (ref, opts))

    def find_identity(self, username, realm_type, realm_id):
        return self.conn.execute(
            "SELECT * FROM identities WHERE username=? AND realm_type=? AND realm_id=?",
            (username, realm_type, realm_id)).fetchone()

    def live_secrets_for_identity(self, identity_id):
        return self.conn.execute(
            "SELECT s.* FROM identity_secrets il JOIN secrets s ON s.id=il.secret_id "
            "WHERE il.identity_id=? AND il.superseded=0", (identity_id,)).fetchall()


