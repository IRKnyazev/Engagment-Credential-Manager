def now_iso():
    return datetime.now().isoformat(timespec="seconds")


def mask(value):
    """Short, safe-ish preview of a secret value for echo lines."""
    if value == "":
        return "(blank)"
    if len(value) <= 24:
        return value
    return value[:21] + "..."


def read_blob_file(path):
    try:
        with open(path, "rb") as fh:
            data = fh.read()
    except OSError as e:
        raise CmError("cannot read %s: %s" % (path, e))
    return base64.b64encode(data).decode("ascii"), os.path.basename(path)


# pure-hex hash types whose canonical form is lowercase (safe to normalise).
# NOT the unix-crypt types (bcrypt/sha*crypt salts are case-sensitive) nor the
# NetNTLM/Kerberos strings (they carry user/domain labels); potfile matching
# already compares those case-insensitively.
HEX_NORMALIZE_TYPES = {"ntlm", "lm"}


def normalize_hash(stype, value):
    if stype in HEX_NORMALIZE_TYPES:
        return value.strip().lower()
    return value


def secret_from_args(args):
    """Build (type, value, label, filename, expires) from secret flags, or None."""
    given = [bool(getattr(args, "password", None) is not None),
             bool(getattr(args, "nt", None)),
             bool(getattr(args, "hash", None)),
             bool(getattr(args, "key", None)),
             bool(getattr(args, "pfx", None)),
             bool(getattr(args, "ticket", None))]
    if sum(given) == 0:
        return None
    if sum(given) > 1:
        raise CmError("give only one of --pass/--nt/--hash/--key/--pfx/--ticket")
    label = getattr(args, "label", "") or ""
    expires = getattr(args, "expires", None)
    if getattr(args, "password", None) is not None:
        return ("plaintext", args.password, label, None, None)
    if getattr(args, "nt", None):
        # pure-hex hashes have a canonical lowercase form (matches tool output and
        # hashcat potfiles, so dedup and crack round-trips work)
        return ("ntlm", normalize_hash("ntlm", args.nt.strip()), label, None, None)
    if getattr(args, "hash", None):
        htype, sep, hval = args.hash.partition(":")
        if not sep:
            raise CmError("--hash must be TYPE:VALUE, e.g. kerberos_tgs:'$krb5tgs$...'")
        if htype not in SECRET_TYPES:
            raise CmError("unknown hash type %r (valid: %s)" % (htype, ", ".join(sorted(CRACKABLE_TYPES))))
        return (htype, normalize_hash(htype, hval), label, None, None)
    if getattr(args, "key", None):
        b64, fn = read_blob_file(args.key)
        return ("ssh_private_key", b64, label, fn, None)
    if getattr(args, "pfx", None):
        b64, fn = read_blob_file(args.pfx)
        return ("certificate_pfx", b64, label, fn, None)
    if getattr(args, "ticket", None):
        b64, fn = read_blob_file(args.ticket)
        return ("kerberos_ticket", b64, label, fn, expires)
    return None


def resolve_identity(store, args, need_realm=True):
    """Resolve the principal + realm from args into (username, realm_type, realm_id)."""
    token = getattr(args, "identity", None)
    null_flag = getattr(args, "null", False)
    realm_opt = getattr(args, "realm", None)
    if null_flag:
        username = ""
        hint = (None,)
    elif token is None:
        raise CmError("an identity is required (e.g. 'CORP\\jsmith', 'bob@10.0.0.5', or --null)")
    else:
        username, hint = parse_principal(token)

    svc_name = ""
    if realm_opt:
        realm_hint = parse_realm_opt(realm_opt)
    elif hint[0] is not None:
        realm_hint = hint
    elif null_flag and getattr(args, "at", None):
        # infer realm for a null/anonymous session from its target, using the
        # same scope decision the access target uses (so smb:445 -> host, not service)
        scope, host, port = decide_scope(args.at, getattr(args, "proto", None),
                                         getattr(args, "scope", None))
        realm_hint = ("service", host, port) if scope == "service" and port else ("host", host)
    else:
        realm_hint = ("unknown",)
        if need_realm:
            store.note("[assumed: realm unknown for %r - pass --realm to pin it]"
                       % (username or "(null)"))
    rtype, rid = store.resolve_place(realm_hint, svc_name)
    return username, rtype, rid


def decide_scope(at, proto, scope_opt):
    """Pure decision: (scope, host, port) from a target string + proto + override.

    No side effects - used both for access targets and for inferring a
    null/anonymous session's realm, so the two always agree.
    """
    host, port = split_host_port(at)
    proto = (proto or "").lower()
    if scope_opt:
        scope = scope_opt
    elif proto in PROTO_DEFAULTS:
        scope = PROTO_DEFAULTS[proto][0]
    elif port is not None:
        scope = "service"
    else:
        scope = "host"
    if scope == "service" and port is None and proto in PROTO_DEFAULTS and PROTO_DEFAULTS[proto][1]:
        port = PROTO_DEFAULTS[proto][1]
    return scope, host, port


def resolve_target(store, args, allow_missing=False):
    """Resolve --at into (scope, host_id, service_id), creating places. Prints assumptions."""
    at = getattr(args, "at", None)
    if not at:
        if allow_missing:
            return None
        raise CmError("--at HOST[:PORT] is required")
    proto = (getattr(args, "proto", None) or "").lower()
    scope_opt = getattr(args, "scope", None)
    raw_host, raw_port = split_host_port(at)
    scope, host, port = decide_scope(at, proto, scope_opt)

    assumed = []
    if not scope_opt and proto in PROTO_DEFAULTS and (scope == "service") != (raw_port is not None):
        assumed.append("%s -> %s-auth (scope=%s)" % (proto, scope, scope))
    elif not scope_opt and proto and proto not in PROTO_DEFAULTS and raw_port is None:
        assumed.append("%s -> host-auth (scope=host)" % proto)

    hid, _ = store.upsert_host(host)
    if scope == "host":
        if assumed:
            store.note("[assumed: %s]" % "; ".join(assumed))
        return ("host", hid, None)

    if port is None:
        raise CmError("service access needs a port: use --at %s:PORT" % host)
    if raw_port is None:
        assumed.append("port %d for %s" % (port, proto))
    # key the service row by host:port only (service name left ""), so a service
    # identity's realm and its access land on the SAME services row; the protocol
    # is recorded on the access, not duplicated into the service name.
    sid, _ = store.upsert_service(hid, port, "")
    if assumed:
        store.note("[assumed: %s]" % "; ".join(assumed))
    return ("service", None, sid)


def pick_secret_for_identity(store, args, identity_id, action):
    """For works/fail/access/supersede: use a secret flag, --secret, or infer."""
    spec = secret_from_args(args)
    if spec:
        sid, _ = store.upsert_secret(*spec)
        return sid
    if getattr(args, "secret", None):
        return store.resolve_secret_ref(args.secret)["id"]
    live = store.live_secrets_for_identity(identity_id)
    if len(live) == 1:
        return live[0]["id"]
    if len(live) > 1:
        # common case: a hash was cracked, so the identity now holds the hash AND
        # the plaintext. Prefer the single plaintext - you log in with the password.
        plains = [s for s in live if s["type"] == "plaintext"]
        if len(plains) == 1:
            return plains[0]["id"]
        opts = ", ".join(store.secret_short(s) for s in live)
        raise CmError("identity has several live secrets - pick one with --secret: %s" % opts)
    # no live secret
    if getattr(args, "null", False):
        sid, _ = store.upsert_secret("plaintext", "")  # null/anonymous session
        return sid
    raise CmError("no secret known for this identity - give --pass/--nt/--hash/--secret")


